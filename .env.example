# CLI and Gradio integrations
CONTEXT_DEV_API_KEY=
MISTRAL_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional: defaults to mistral-small-latest
MISTRAL_MODEL=mistral-small-latest
# Optional: use /data/milieu on Spaces with persistent storage
MILIEU_HOME=.milieu

# Web product and Docker Compose
# Keep separate .env files for staging and production with mode 0600.
# For staging use https://staging.agentmilieu.naninithin.me and port 8086.
PUBLIC_URL=https://agentmilieu.naninithin.me
APP_PORT=8080
POSTGRES_PASSWORD=
# Use the same PostgreSQL password in this URL, URL-encoding it if needed.
DATABASE_URL=postgresql://agentmilieu:YOUR_URL_ENCODED_PASSWORD@db:5432/agentmilieu
# Generate at least 32 random characters for each environment.
SESSION_SECRET=
# Register <PUBLIC_URL>/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use a Mollie test key in staging and a live key in production.
MOLLIE_API_KEY=

# Optional managed model. Leave URL blank to use the official API for the selected kind.
MANAGED_PROVIDER_KIND=openai
MANAGED_PROVIDER_URL=
MANAGED_PROVIDER_MODEL=
MANAGED_PROVIDER_KEY=
